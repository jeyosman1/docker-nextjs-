<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Users</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; background: #f5f5f5; }
    h1 { color: #333; }
    form { background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; }
    input { padding: 8px; margin-right: 8px; border: 1px solid #ddd; border-radius: 4px; }
    button { padding: 8px 16px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .user-card { background: white; padding: 16px; margin-bottom: 12px; border-radius: 8px; }
    .user-card h3 { color: #2563eb; margin: 0 0 8px 0; }
    .user-card p { color: #666; margin: 4px 0; }
    .empty { color: #999; text-align: center; padding: 40px; }
  </style>
</head>
<body>
  <h1>Add User</h1>
  <form action="/users" method="POST">
    <input type="text" name="name" placeholder="Name" required>
    <input type="number" name="age" placeholder="Age">
    <input type="email" name="email" placeholder="Email">
    <button type="submit">Add</button>
  </form>

  <h1>All Users</h1>
  <% if (users.length === 0) { %>
    <p class="empty">No users yet.</p>
  <% } else { %>
    <% users.forEach(user => { %>
      <div class="user-card">
        <h3><%= user.name %></h3>
        <p>Age: <%= user.age ?? 'N/A' %></p>
        <p>Email: <%= user.email ?? 'N/A' %></p>
      </div>
    <% }) %>
  <% } %>
</body>
</html>